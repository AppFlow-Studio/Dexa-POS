<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Castles Technology Co., Ltd. — USB vendor ID 0x0CA6 (3238 decimal).
      Saturn1000 USB pin pad. Declaring the device here makes Android:
        1. grant the app persistent USB permission (no per-plug dialog), and
        2. deliver USB_DEVICE_ATTACHED to MainActivity on plug-in,
      which drives the zero-touch auto-connect flow.
      Matched by vendor only so all Castles models are covered.
    -->
    <usb-device vendor-id="3238" />
    <!--
      Valor VP terminal — USB vendor ID 0x1E0E (7694 decimal), a Qualcomm
      "Android Diag" CDC serial interface. Same purpose as above: persistent USB
      permission + USB_DEVICE_ATTACHED for zero-touch auto-connect. 0x1E0E is a
      shared Qualcomm VID; JS-side (valor-transport-usb.ts) narrows to the Valor
      terminal by product-name hints when multiple Qualcomm devices are present.
    -->
    <usb-device vendor-id="7694" />
</resources>
