+// --- patch-package: bounded fd concurrency (Windows EMFILE guard) ----------
+// Upstream calls node:fs promises directly here, unlike the rest of Metro,
+// which goes through graceful-fs. Metro fans the transform cache out over the
+// entire subgraph at once (Promise.all over 1000+ modules), so on Windows the
+// process runs out of file handles and the bundle dies with:
+//   EMFILE: too many open files, open '...\metro-cache\..\....mp'
+// HMR then retries forever and the dev app crawls. A simple semaphore around
+// every fs call in this file keeps handles bounded without changing behavior.
+// Tune with EXPO_METRO_FD_LIMIT if 64 is still too high on a given machine.
+const FD_LIMIT = Number(process.env.EXPO_METRO_FD_LIMIT) || 64;
+let fdActive = 0;
+const fdQueue = [];
+function fdAcquire() {
+    if (fdActive < FD_LIMIT) {
+        fdActive++;
+        return Promise.resolve();
+    }
+    return new Promise((resolve) => fdQueue.push(resolve));
+}
+function fdRelease() {
+    const next = fdQueue.shift();
+    // Hand the slot straight to the next waiter rather than decrementing and
+    // letting it re-acquire — keeps the count exact under heavy contention.
+    if (next)
+        next();
+    else
+        fdActive--;
+}
+async function withFd(fn) {
+    await fdAcquire();
+    try {
+        return await fn();
+    }
+    finally {
+        fdRelease();
+    }
+}
