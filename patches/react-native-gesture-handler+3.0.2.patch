diff --git a/node_modules/react-native-gesture-handler/android/CMakeLists.txt b/node_modules/react-native-gesture-handler/android/CMakeLists.txt
index ae44354..b8300b3 100644
--- a/node_modules/react-native-gesture-handler/android/CMakeLists.txt
+++ b/node_modules/react-native-gesture-handler/android/CMakeLists.txt
@@ -4,7 +4,14 @@ project(GestureHandlerCodegen)
 set(CMAKE_VERBOSE_MAKEFILE on)
 set(CMAKE_CXX_STANDARD 20)
 
-file(GLOB_RECURSE rn_gesture_handler_SRCS CONFIGURE_DEPENDS ../shared/shadowNodes/*.cpp)
+# Windows MAX_PATH fix. ../shared/shadowNodes is outside this CMakeLists' source
+# dir, so CMake names its object files by mirroring the full absolute source path
+# (CMakeFiles/<target>.dir/C_/Users/.../RNGestureHandlerDetectorShadowNode.cpp.o).
+# That lands at 288 chars and ninja hard-fails any path over 260 regardless of the
+# LongPathsEnabled registry setting. Staging the sources into the binary dir makes
+# them in-tree, so CMake emits a short relative object path instead.
+file(COPY ../shared/shadowNodes/ DESTINATION ${CMAKE_CURRENT_BINARY_DIR}/sn)
+file(GLOB_RECURSE rn_gesture_handler_SRCS CONFIGURE_DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/sn/*.cpp)
 file(GLOB_RECURSE rn_gesture_handler_codegen_SRCS CONFIGURE_DEPENDS ./build/generated/source/codegen/jni/*.cpp)
 
 add_library(
@@ -18,7 +25,7 @@ if(ReactAndroid_VERSION_MINOR GREATER_EQUAL 80)
   target_compile_reactnative_options(react_codegen_rngesturehandler_codegen PRIVATE)
 endif()
 
-target_include_directories(react_codegen_rngesturehandler_codegen PUBLIC ../shared/shadowNodes)
+target_include_directories(react_codegen_rngesturehandler_codegen PUBLIC ${CMAKE_CURRENT_BINARY_DIR}/sn)
 target_include_directories(react_codegen_rngesturehandler_codegen PUBLIC ./build/generated/source/codegen/jni)
 
