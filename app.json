{
  "expo": {
    "name": "Dexa-POS",
    "slug": "dexa-pos",
    "version": "2.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/dexalogo.png",
    "scheme": "dexapos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.temurappflowstudios.dexapos",
      "runtimeVersion": "2.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dexalogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.temurappflowstudios.dexapos",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "runtimeVersion": "2.0.0"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableProguardInReleaseBuilds": true,
            "shrinkResources": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dexalogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/dexalogo.png",
            "backgroundColor": "#0C0F1A"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client",
      "expo-audio",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dexa-pos",
          "organization": "appflow-studios"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0e0ce4a-6ad2-4ad5-9a23-47131c7f3bc2"
      }
    },
    "owner": "appflow-studios",
    "updates": {
      "url": "https://u.expo.dev/b0e0ce4a-6ad2-4ad5-9a23-47131c7f3bc2",
      "enabled": true,
      "checkOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0
    }
  }
}
