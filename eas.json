{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
       "android": {
        "buildType": "apk"
      }
    },
    "unsigned-production": {
      "environment": "production",
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
