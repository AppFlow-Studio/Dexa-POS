{
  "permissions": {
    "allow": ["Bash(npx tsc *)", "Bash(xargs grep -l \"AppState\")"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/notify.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/notify.js"
          }
        ]
      }
    ]
  }
}
